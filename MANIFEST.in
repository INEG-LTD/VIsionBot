# Include docs and metadata
include README.md
include TERMINOLOGY.md
include requirements.txt
include LICENSE

# Include all python modules and packages
recursive-include browser_vision_bot *.py
recursive-include agent *.py
recursive-include models *.py
recursive-include utils *.py

# Exclude caches and compiled artifacts
global-exclude __pycache__ *.py[co] *.so .DS_Store
